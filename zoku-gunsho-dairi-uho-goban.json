 "blocks": [
  {
   "id": "zoku-gunsho-dairi-uho-goban-0001",
   "pid": "nao-734041",
   "pages": [
    1
   ],
   "text": "右右近君なみのうへにはおもいろをはをかなめて水は量らぬ月をしやまて内裏歌合右方後番承暦二年四月晦日子日霞鶯楊藤花菖蒲五月雨郭公七夕月鹿紅葉雪祝衣歌人保實朝臣美作君作匡房朝臣通俊朝臣伊家通浦顯綱朝臣何通家",
   "poems": [
    "1"
   ]
  },
  {
   "id": "zoku-gunsho-dairi-uho-goban-0002",
   "pid": "nao-734041",
   "pages": [
    2
   ],
   "text": "母作公実朝臣為我朝臣紀伊君季実公定朝臣作第三次太焼人一番子日左皇后宮美作君朝臣代保実にやくもなる子のこまつ引うへてはなさしよを君そみるへき右勝美作守匡房今日よりはねのひの松もひきかへてやをよろつよの春をこそまて二番霞左右中弁通俊あさまたき山のかすみを見わたせはよをさへこめて立にける哉右勝かつらきやたかまの山のあさかすて春ともにもにも立にけるかな",
   "poems": [
    "2",
    "3",
    "4",
    "5"
   ]
  },
  {
   "id": "zoku-gunsho-dairi-uho-goban-0003",
   "pid": "nao-734041",
   "pages": [
    3
   ],
   "text": "一左歌のよをさへこめてたちにけるかなといへるはあさまたきかすみをこむによをこめて殿ちにけりとはしりかたしとおほせことあるに通僧ふかき歌にはなをよむにまたよをこめてちめてちりにけるかなとよめりとまらすにそれはこすゑをみるに花のおけれはいはれれはこすゑをみるに花のなけれはいはれたりこれにはにすとてまけぬ三番鶯左持伊勢春くれはすたちのをのゝうくひすの色ならはしに今そ時なに右顕綱朝臣する風にゆきのしたみつうちとけて谷のうくひす今そ鳴なる此歌ともの姿心かなしやうなりとて持に成ぬ四番梅左持通宗左通宗出しむにはちりもとまらて桜花あかぬ心そときは成ける匡房右山桜出しむにちらぬ物なしは花は春ともかきらさらましいつれもおなし心なりとて特に成ぬ",
   "poems": [
    "6",
    "7",
    "8",
    "9"
   ],
   "notes": [
    {
     "a": "通宗左通宗",
     "n": "通輔に替て",
     "k": "割注"
    }
   ]
  },
  {
   "id": "zoku-gunsho-dairi-uho-goban-0004",
   "pid": "nao-734041",
   "pages": [
    4
   ],
   "text": "五番藤花左通俊すみの元にわかしめをきしふちかものにほふさかりにけるはさにけり右勝伊家藤の花さきそめしより松ならぬ心にかれてみぬかりそなき左歌は姿うためきたれともさせる心なし右歌はふかめきたれとも心ありとてかちぬ六番菖蒲左持なかきねを心にかけてあやめ草たつねぬゝまの今日はなきかな右土実たまえにや今日のあやめを引つらん又かける宿のつまにみゆるは左歌はあやめも見へす右歌は見かけるやとゝいへるなにことも見へすとて持になかぬ七番五月雨左勝通俊つれ〳〵とふるきみたれは日もくれぬ軒のしつくのをとはかりして右匡房さみたれはたこのもすそやくちぬらん衣ほすへきひましなけれは八番郭公",
   "poems": [
    "10",
    "11",
    "12",
    "13",
    "14",
    "15"
   ]
  },
  {
   "id": "zoku-gunsho-dairi-uho-goban-0005",
   "pid": "nao-734041",
   "pages": [
    5
   ],
   "text": "左みちとしあれはまつ人にかたらんかとゝきすよふかくやとをなきてすれはまさふと右さつきやいくよまたれて郭公おとはの山のかゐになくらん九番七夕左持為家母たおはたのくものころもゝまれにきてかさねあへすや立かへるらん右匡房たなはたのあひみぬ秋はおけれともとしにや恋のかすまさるらん左右歌とも心あまりてことはたらすとて持になりぬ十番月左公定朝臣月かけのいたらぬくまはなけれともわるかに雲のうへはのとけし右後公實朝臣くもりなきかけをとゝめは山のみにいるとも月をおしまさらまし左歌は心えられすあめつしたにてこそあかしくらしもいはめ雲のうへとしたとをはいかてかくらへんとてまけぬ十一番鹿",
   "poems": [
    "16",
    "17",
    "18",
    "19",
    "20",
    "21"
   ]
  },
  {
   "id": "zoku-gunsho-dairi-uho-goban-0006",
   "pid": "nao-734041",
   "pages": [
    6
   ],
   "text": "左持季実替一宮紀伊君秋風そさむくふくらし妻こふる走たかさこにをしかなくなり右匡房恋わたるつまならなくに思ひこのこたふるこゑをしるやきくらむ右歌は山ひとわな所のこゑにこたふれはしかはきくそまつなくといふことあるへしといふや但左分もよからねはとて持になりぬ十二番紅葉左持通渡一去くれするもうのもみちの色ふかみ秋をこすゑにそめてけるかな右公実一時雨つゝしたものこらすもみちして空さへてらす神なひのもり右歌はそうてらすといはゝそはとこそよむへけれとてまけぬ十三番雪左持紀伊君みやこまにあとたつはかりふる雪にこしのたかねをおもひこそやれ右かにさえのあしのはしのきふる雪にこやのしのにもあとたへにけり十四番祝",
   "poems": [
    "22",
    "23",
    "24",
    "25",
    "26",
    "27"
   ]
  },
  {
   "id": "zoku-gunsho-dairi-uho-goban-0007",
   "pid": "nao-734041",
   "pages": [
    7
   ],
   "text": "左特美作君き見かよはくらひの山にとしを経てさかゆくすゑのはるかなるかな匡房右きみかよはゆくゑもしらぬあたつうみのおはしろ水に成かはるまて右分は長元の歌合にも山のうみとならんあちきなしと定たりこれも心に似たりたの歌は心ゆきてもおほえすとて持に定させたまふおなし心なれはとてまけぬ十五番恋左伊家わかこひは夢ちにのみそなくさむるつれなき人にあふとみゆれは右勝匡房おもひかねいまは我身そうらめしきなとうき人のこひしけらゝ此度はみな右方歌也廿八日の哥合はかりの歌むけにみくるしきにかつとさへ立たるのちのよのそしられわかよのはちなりとおほせられて右のかきりをあはせて御判にせさせたまふたののこりひもめしてこらんするにゆゝしき歌のかきりあれはそれはすてさせたまひてあはせられす",
   "poems": [
    "28",
    "29",
    "30",
    "31"
   ]
  },
  {
   "id": "zoku-gunsho-dairi-uho-goban-0008",
   "pid": "nao-734041",
   "pages": [
    8
   ],
   "text": "とす十四間五十一",
   "poems": []
  }
 ],
 "poems": [
  {
   "seq": "1",
   "text": "なみのうへにはおもいろをはをかなめて水は量らぬ月をしやまて",
   "kana": "",
   "speaker": "右近君",
   "page": 1,
   "pid": "nao-734041",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "2",
   "text": "にやくもなる子のこまつ引うへてはなさしよを君そみるへき",
   "kana": "",
   "speaker": "代保実",
   "page": 2,
   "pid": "nao-734041",
   "form": "短歌",
   "genre": "",
   "ban": "一",
   "side": "",
   "dai": ""
  },
  {
   "seq": "3",
   "text": "今日よりはねのひの松もひきかへてやをよろつよの春をこそまて",
   "kana": "",
   "speaker": "美作守匡房",
   "page": 2,
   "pid": "nao-734041",
   "form": "短歌",
   "genre": "",
   "ban": "一",
   "side": "右",
   "dai": "勝"
  },
  {
   "seq": "4",
   "text": "あさまたき山のかすみを見わたせはよをさへこめて立にける哉",
   "kana": "",
   "speaker": "右中弁通俊",
   "page": 2,
   "pid": "nao-734041",
   "form": "短歌",
   "genre": "",
   "ban": "二",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "5",
   "text": "かつらきやたかまの山のあさかすて春ともにもにも立にけるかな",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-734041",
   "form": "短歌",
   "genre": "",
   "ban": "二",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "6",
   "text": "春くれはすたちのをのゝうくひすの色ならはしに今そ時なに",
   "kana": "",
   "speaker": "伊家",
   "page": 3,
   "pid": "nao-734041",
   "form": "短歌",
   "genre": "",
   "ban": "三",
   "side": "",
   "dai": ""
  },
  {
   "seq": "7",
   "text": "する風にゆきのしたみつうちとけて谷のうくひす今そ鳴なる",
   "kana": "",
   "speaker": "顕綱朝臣",
   "page": 3,
   "pid": "nao-734041",
   "form": "短歌",
   "genre": "",
   "ban": "三",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "8",
   "text": "出しむにはちりもとまらて桜花あかぬ心そときは成ける",
   "kana": "",
   "speaker": "通宗",
   "page": 3,
   "pid": "nao-734041",
   "form": "短歌",
   "genre": "",
   "ban": "四",
   "side": "左",
   "dai": "持"
  },
  {
   "seq": "9",
   "text": "山桜出しむにちらぬ物なしは花は春ともかきらさらまし",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-734041",
   "form": "短歌",
   "genre": "",
   "ban": "四",
   "side": "右",
   "dai": "持"
  },
  {
   "seq": "10",
   "text": "すみの元にわかしめをきしふちかものにほふさかりにけるはさにけり",
   "kana": "",
   "speaker": "通俊",
   "page": 4,
   "pid": "nao-734041",
   "form": "短歌",
   "genre": "",
   "ban": "五",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "11",
   "text": "藤の花さきそめしより松ならぬ心にかれてみぬかりそなき",
   "kana": "",
   "speaker": "伊家",
   "page": 4,
   "pid": "nao-734041",
   "form": "短歌",
   "genre": "",
   "ban": "五",
   "side": "右",
   "dai": "勝伊家"
  },
  {
   "seq": "12",
   "text": "なかきねを心にかけてあやめ草たつねぬゝまの今日はなきかな",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-734041",
   "form": "短歌",
   "genre": "",
   "ban": "六",
   "side": "左",
   "dai": "特"
  },
  {
   "seq": "13",
   "text": "たまえにや今日のあやめを引つらん又かける宿のつまにみゆるは",
   "kana": "",
   "speaker": "土実",
   "page": 4,
   "pid": "nao-734041",
   "form": "短歌",
   "genre": "",
   "ban": "六",
   "side": "右",
   "dai": "特"
  },
  {
   "seq": "14",
   "text": "つれ〳〵とふるきみたれは日もくれぬ軒のしつくのをとはかりして",
   "kana": "",
   "speaker": "通俊",
   "page": 4,
   "pid": "nao-734041",
   "form": "短歌",
   "genre": "",
   "ban": "七",
   "side": "左",
   "dai": "勝"
  },
  {
   "seq": "15",
   "text": "さみたれはたこのもすそやくちぬらん衣ほすへきひましなけれは",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-734041",
   "form": "短歌",
   "genre": "",
   "ban": "七",
   "side": "右",
   "dai": "勝"
  },
  {
   "seq": "16",
   "text": "あれはまつ人にかたらんかとゝきすよふかくやとをなきてすれは",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-734041",
   "form": "短歌",
   "genre": "",
   "ban": "八",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "17",
   "text": "さつきやいくよまたれて郭公おとはの山のかゐになくらん",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-734041",
   "form": "短歌",
   "genre": "",
   "ban": "八",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "18",
   "text": "たおはたのくものころもゝまれにきてかさねあへすや立かへるらん",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-734041",
   "form": "短歌",
   "genre": "",
   "ban": "九",
   "side": "左",
   "dai": "持為家母"
  },
  {
   "seq": "19",
   "text": "たなはたのあひみぬ秋はおけれともとしにや恋のかすまさるらん",
   "kana": "",
   "speaker": "匡房",
   "page": 5,
   "pid": "nao-734041",
   "form": "短歌",
   "genre": "",
   "ban": "九",
   "side": "右",
   "dai": "持為家母"
  },
  {
   "seq": "20",
   "text": "月かけのいたらぬくまはなけれともわるかに雲のうへはのとけし",
   "kana": "",
   "speaker": "公定朝臣",
   "page": 5,
   "pid": "nao-734041",
   "form": "短歌",
   "genre": "",
   "ban": "十",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "21",
   "text": "くもりなきかけをとゝめは山のみにいるとも月をおしまさらまし",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-734041",
   "form": "短歌",
   "genre": "",
   "ban": "十",
   "side": "右",
   "dai": "衛門"
  },
  {
   "seq": "22",
   "text": "秋風そさむくふくらし妻こふる走たかさこにをしかなくなり",
   "kana": "",
   "speaker": "一宮紀伊君",
   "page": 6,
   "pid": "nao-734041",
   "form": "短歌",
   "genre": "",
   "ban": "十一",
   "side": "左",
   "dai": "持"
  },
  {
   "seq": "23",
   "text": "恋わたるつまならなくに思ひこのこたふるこゑをしるやきくらむ",
   "kana": "",
   "speaker": "匡房",
   "page": 6,
   "pid": "nao-734041",
   "form": "短歌",
   "genre": "",
   "ban": "十一",
   "side": "右",
   "dai": "持"
  },
  {
   "seq": "24",
   "text": "一去くれするもうのもみちの色ふかみ秋をこすゑにそめてけるかな",
   "kana": "",
   "speaker": "通渡",
   "page": 6,
   "pid": "nao-734041",
   "form": "短歌",
   "genre": "",
   "ban": "十二",
   "side": "左",
   "dai": "勝"
  },
  {
   "seq": "25",
   "text": "一時雨つゝしたものこらすもみちして空さへてらす神なひのもり",
   "kana": "",
   "speaker": "公実",
   "page": 6,
   "pid": "nao-734041",
   "form": "短歌",
   "genre": "",
   "ban": "十二",
   "side": "右",
   "dai": "勝"
  },
  {
   "seq": "26",
   "text": "みやこまにあとたつはかりふる雪にこしのたかねをおもひこそやれ",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-734041",
   "form": "短歌",
   "genre": "",
   "ban": "十三",
   "side": "左",
   "dai": "持紀伊君"
  },
  {
   "seq": "27",
   "text": "かにさえのあしのはしのきふる雪にこやのしのにもあとたへにけり",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-734041",
   "form": "短歌",
   "genre": "",
   "ban": "十三",
   "side": "",
   "dai": "持紀伊君"
  },
  {
   "seq": "28",
   "text": "き見かよはくらひの山にとしを経てさかゆくすゑのはるかなるかな",
   "kana": "",
   "speaker": "美作君",
   "page": 7,
   "pid": "nao-734041",
   "form": "短歌",
   "genre": "",
